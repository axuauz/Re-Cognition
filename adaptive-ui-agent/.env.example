# 이 파일을 .env 로 복사한 뒤 키를 넣고  node scripts/load-env.js  를 실행하세요.
# OpenAI(sk-...), OpenRouter(sk-or-...), Gemini(AIza...) 키를 모두 받습니다.
AI_API_KEY=
# 선택: 비워 두면 설정 탭에서 고른 모델을 씁니다.
AI_MODEL=
# 선택: 소리→글자(자막)에만 쓸 키. 비우면 AI_API_KEY 를 씁니다.
STT_API_KEY=
# 선택: OpenRouter 키로 받아쓸 때의 오디오 입력 모델 (기본 google/gemini-3.5-flash-lite)
STT_MODEL=
